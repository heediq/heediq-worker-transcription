# Paid tier: whisper large-v3 + pyannote diarization (D-059, D-062, D-060). Model weights baked
# in at build time — same zero-runtime-network-dependency rationale as Dockerfile.free.
#
# pyannote's pretrained pipeline is a gated HF model — the bake step needs a HF token with
# access accepted, passed as a BuildKit secret (never persisted in an image layer or in
# GitHub Actions logs): `docker build --secret id=hf_token,env=HF_TOKEN -f Dockerfile.paid .`
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    WHISPER_MODEL=large-v3 \
    DIARIZE=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

RUN python3 -c "from faster_whisper import WhisperModel; WhisperModel('large-v3', device='cpu', compute_type='int8')"

RUN --mount=type=secret,id=hf_token \
    HF_TOKEN=$(cat /run/secrets/hf_token) python3 -c "
import os
from pyannote.audio import Pipeline
Pipeline.from_pretrained('pyannote/speaker-diarization-3.1', use_auth_token=os.environ['HF_TOKEN'])
"

COPY src ./src

ENTRYPOINT ["python3", "-m", "src.worker"]
